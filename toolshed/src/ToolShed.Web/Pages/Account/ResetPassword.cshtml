@page
@model ToolShed.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<h1>Choose a new password</h1>

@if (Model.LinkIsBroken)
{
    <div class="notice notice-bad">
        <p>This reset link is not valid. It may have expired, or already been used.</p>
    </div>
    <p><a asp-page="/Account/ForgotPassword">Ask for a fresh one</a></p>
}
else
{
    <partial name="_ValidationSummary" model="ModelState" />

    <form method="post" class="card form">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />

        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
        <p class="hint">At least 12 characters, with upper and lower case, a digit and a symbol.</p>

        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />

        <button type="submit">Set password</button>
    </form>
}
