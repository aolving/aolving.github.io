@page
@model ToolShed.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="muted">This portal is invite only. Ask a member with an admin account for an invitation.</p>

<partial name="_ValidationSummary" model="ModelState" />

<form method="post" class="card form">
    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="username" required />

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" required />

    <label class="checkbox">
        <input asp-for="Input.RememberMe" type="checkbox" />
        Keep me signed in on this device
    </label>

    <button type="submit">Sign in</button>
</form>
