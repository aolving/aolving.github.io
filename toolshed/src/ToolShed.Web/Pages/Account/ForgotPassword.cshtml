@page
@model ToolShed.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot your password?</h1>

@if (Model.Submitted)
{
    <div class="notice notice-good">
        <p>If that address belongs to a member, a reset link is on its way. It works for two hours.</p>
    </div>
    <p><a asp-page="/Account/Login">Back to sign in</a></p>
}
else if (!Model.EmailEnabled)
{
    <p>This portal is not set up to send email, so it cannot mail you a link.</p>
    <p>Ask an administrator for a password reset link instead.</p>
    <p><a asp-page="/Account/Login">Back to sign in</a></p>
}
else
{
    <partial name="_ValidationSummary" model="ModelState" />
    <form method="post" class="card form">
        <label asp-for="Input.Email">Your email</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" required />
        <button type="submit">Email me a reset link</button>
    </form>
}
