<?xml version="1.0" encoding="utf-8" ?>
<pages:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:ToolShed.Mobile.Pages"
                x:Class="ToolShed.Mobile.Pages.LoansPage"
                Title="Loans">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="IncomingButton" Text="Requests for my tools" Clicked="OnShowIncoming" />
            <Button x:Name="OutgoingButton" Grid.Column="1" Text="My requests" Clicked="OnShowOutgoing" />
        </Grid>

        <RefreshView x:Name="Refresh" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="List" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label x:Name="EmptyLabel" HorizontalOptions="Center" TextColor="{StaticResource Muted}" Margin="0,32" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Dates}" FontSize="13" TextColor="{StaticResource Muted}" />
                                <Label Text="{Binding StatusText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="13" FontAttributes="Italic" />

                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                    <Button Text="Approve" IsVisible="{Binding CanDecide}" Clicked="OnApprove" />
                                    <Button Text="Decline" IsVisible="{Binding CanDecide}" Style="{StaticResource DangerButton}" Clicked="OnDecline" />
                                    <Button Text="Mark returned" IsVisible="{Binding CanMarkReturned}" Clicked="OnReturned" />
                                    <Button Text="Cancel" IsVisible="{Binding CanCancel}" Style="{StaticResource DangerButton}" Clicked="OnCancel" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</pages:PageBase>
