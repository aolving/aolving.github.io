<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolShed.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Brand">#8A4B1E</Color>
            <Color x:Key="Good">#2F6B3A</Color>
            <Color x:Key="Danger">#9A2F2F</Color>
            <Color x:Key="Amber">#8A6D1E</Color>
            <Color x:Key="Muted">#7A7368</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F7F4EF, Dark=#1A1816}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1A17, Dark=#ECE7DF}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1A17, Dark=#ECE7DF}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1A17, Dark=#ECE7DF}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1A17, Dark=#ECE7DF}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1A17, Dark=#ECE7DF}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Brand}" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#DDD6CA, Dark=#3A352F}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#23201D}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
