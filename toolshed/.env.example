# Public hostname that points at this machine. Caddy gets a certificate for it.
PORTAL_DOMAIN=tools.example.com

# The first administrator. Leave ADMIN_PASSWORD empty to have one generated and
# printed once in `docker compose logs toolshed`.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

PORTAL_NAME=The Tool Shed

# Optional. With no SMTP_HOST the portal still works: invitation and reset links are
# shown on screen for you to pass on yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
